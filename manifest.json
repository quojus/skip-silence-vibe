{
  "manifest_version": 3,
  "name": "Skip Silence Vibe",
  "version": "0.2.0",
  "description": "Überspringt Stille in Video und Audio – Einstellungen pro Tab.",
  "browser_specific_settings": {
    "gecko": {
      "id": "skip-silence-eigen@falk.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/defaults.js",
      "lib/modes.js",
      "lib/sites.js",
      "lib/stats.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": [
        "lib/defaults.js",
        "lib/bezier.js",
        "lib/detector.js",
        "lib/sites.js",
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "volume-processor.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg",
    "default_title": "Skip Silence"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "commands": {
    "toggle-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Skip Silence im aktuellen Tab an/aus"
    }
  }
}
